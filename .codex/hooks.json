{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox auto-approve-safe-bash.sh+check-cr-marker-on-pr-create.sh+block-read-secrets.sh+block-destructive-commands.sh+block-docker-privesc.sh+block-merged-pr-commit.sh+block-terminal-write-fence.sh+block-lesson-enforcement-writes.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox auto-approve-safe-bash.sh+check-cr-marker-on-pr-create.sh+block-read-secrets.sh+block-destructive-commands.sh+block-docker-privesc.sh+block-merged-pr-commit.sh+block-terminal-write-fence.sh+block-lesson-enforcement-writes.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox block-read-secrets.sh+block-destructive-commands.sh+block-docker-privesc.sh+block-merged-pr-commit.sh+block-terminal-write-fence.sh+block-lesson-enforcement-writes.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox block-read-secrets.sh+block-destructive-commands.sh+block-docker-privesc.sh+block-merged-pr-commit.sh+block-terminal-write-fence.sh+block-lesson-enforcement-writes.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox block-read-secrets.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox block-read-secrets.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox block-edit-on-main.sh+block-lesson-enforcement-writes.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox block-edit-on-main.sh+block-lesson-enforcement-writes.sh",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__plugin_atlassian_atlassian__.*",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox block-backend-tier.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox block-backend-tier.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox auto-arm-on-cap.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox auto-arm-on-cap.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox auto-arm-on-subagent-cap.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox auto-arm-on-subagent-cap.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox --lifecycle check-update-available.sh+inject-initiative.sh+inject-where-are-we.sh+inject-doc-freshness.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox --lifecycle check-update-available.sh+inject-initiative.sh+inject-where-are-we.sh+inject-doc-freshness.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox --lifecycle refresh-where-are-we-on-end.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox --lifecycle refresh-where-are-we-on-end.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox --lifecycle jira-nudge-on-end.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox --lifecycle jira-nudge-on-end.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox --lifecycle end-session-wiki.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox --lifecycle end-session-wiki.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".codex/run-hook.sh --sandbox --lifecycle telegram-session-end.sh",
            "commandWindows": ".codex/run-hook.cmd --sandbox --lifecycle telegram-session-end.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
