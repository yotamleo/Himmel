{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" \"${CLAUDE_PLUGIN_ROOT}/hooks/inject-minerva-critic.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-docker-privesc.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-merged-pr-commit.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-unresolved-cr-merge.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional --fail-closed-when \"HIMMEL_GLM_WORKER=1\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-glm-external-writes.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-graphify-egress.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-rogue-codex-wsl.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional --fail-closed-when \"HIMMEL_LESSON_LOOP=1\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-lesson-enforcement-writes.sh\""
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-implementor-dispatch.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/inject-where-are-we.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/inject-doc-freshness.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/inject-worktree-nudge.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/refresh-where-are-we-on-end.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/jira-nudge-on-end.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/telegram-session-end.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/run-hook-with-bash.js\" --optional \"$CLAUDE_PROJECT_DIR/scripts/hooks/telegram-notification.sh\""
          }
        ]
      }
    ]
  }
}
