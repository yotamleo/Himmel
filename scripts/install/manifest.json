      "kind": "lane",
      "scopes": ["user"],
      "profiles": ["core", "all"],
      "deps": [],
      "probe": { "type": "telegram-access", "envFile": ".claude/channels/telegram/.env", "tokenKey": "TELEGRAM_BOT_TOKEN", "accessFile": ".claude/channels/telegram/access.json" },
