def run_git(args, cwd=None, check=True, env=None):
    p = subprocess.run(["git"] + args, cwd=cwd, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, env=env)
    if check and p.returncode != 0:
        raise RuntimeError("git %s failed: %s" % (
            " ".join(args), p.stderr.decode("utf-8", "replace")))
    return p.stdout.decode("utf-8", "replace").strip()


# A positive ALLOWLIST is the structural fix for sandbox-escape-via-environment
# (HIMMEL-4168, round 6). Popping named seam variables one at a time never
# converges: BASH_ENV and ENV make bash source an arbitrary script at startup;
# LD_PRELOAD/LD_* inject a shared object; GIT_TEMPLATE_DIR makes `git init`
# copy external hooks into the scratch .git; GIT_DIR/GIT_CONFIG* redirect git
# at a real repo or a real core.hooksPath. Every launched subprocess -- a hook
# under test, and our scratch git -- starts from this list ONLY, so a seam we
# have not enumerated is closed by default rather than open until a later round
# names it. The list is benign, realistic operational variables a guard may
# legitimately read; it contains NO variable that can cause code execution or
# redirect git. GIT_CONFIG_GLOBAL/SYSTEM are forced to an empty file so even a
# real /etc/gitconfig core.hooksPath is not honored.
# HIMMEL_REPO is deliberately NOT inherited: a hook that anchors on it would
# resolve helpers or state against the REAL checkout. run_one_hook overrides it
# to the per-row scratch primary instead, so the anchor points at the throwaway.
_ENV_ALLOW = (
    "PATH", "LANG", "LANGUAGE", "LC_ALL", "LC_CTYPE", "LC_MESSAGES",
    "LC_NUMERIC", "LC_TIME", "LC_COLLATE", "TZ", "TMPDIR", "TMP", "TEMP",
    "TERM", "SHELL", "USER", "LOGNAME", "HOSTNAME",
)


def _sandbox_env(**overrides):
    """A hermetic environment for a launched subprocess: allowlist + overrides.

    Starts from an EMPTY environment, copies only _ENV_ALLOW keys present in
    os.environ, pins global+system git config empty, then applies the caller's
    overrides (HOME, HANDOVER_DIR, CLAUDE_PROJECT_DIR). Nothing outside the
    allowlist -- no BASH_ENV/ENV/LD_PRELOAD/GIT_TEMPLATE_DIR/GIT_DIR/... --
    reaches the child.
    """
    env = {k: os.environ[k] for k in _ENV_ALLOW if k in os.environ}
    env["GIT_CONFIG_GLOBAL"] = os.devnull
    env["GIT_CONFIG_SYSTEM"] = os.devnull
    env.update(overrides)
    return env


def materialise_hook(spec, repo, dest_dir):
    """Return a path to a runnable hook copy, plus a dir to clean up.

    spec is either a filesystem path to a .sh, or `sha:repo-relative-path`.
    The hook is copied into dest_dir alongside a copy of scripts/hooks/ and
    scripts/guardrails/ so its sibling `source` lookups resolve to copies.
    """
    if spec.startswith("sha:"):
        sha, rel = spec[4:].split(":", 1) if ":" in spec[4:] else (spec[4:], None)
        if rel is None:
            raise RuntimeError("sha spec needs sha:REL/PATH form: " + spec)
        blob = subprocess.run(
            ["git", "-C", repo, "show", "%s:%s" % (sha, rel)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if blob.returncode != 0:
            raise RuntimeError("git show %s:%s failed: %s" % (
                sha, rel, blob.stderr.decode("utf-8", "replace")))
        # materialise the whole scripts/hooks + scripts/guardrails tree at sha
        _materialise_tree(repo, sha, dest_dir)
        hook_path = os.path.join(dest_dir, rel)
        with open(hook_path, "wb") as fh:
            fh.write(blob.stdout)
        return hook_path
    # plain path: if the hook lives under a scripts/ tree, copy the sibling
    # hooks/guardrails/lib dirs so its `source ../guardrails/lib.sh` resolves
    # against copies; otherwise (a standalone stub) just copy the one file.
    src_hook = os.path.abspath(spec)
    hooks_root = _find_scripts_root(src_hook)
    if hooks_root is not None:
        _copy_tree(hooks_root, dest_dir)
        rel = os.path.relpath(src_hook, os.path.dirname(hooks_root))
        return os.path.join(dest_dir, rel)
    dst = os.path.join(dest_dir, os.path.basename(src_hook))
    shutil.copyfile(src_hook, dst)
    return dst


def _find_scripts_root(hook_path):
    d = os.path.dirname(hook_path)
    while d and d != "/":
        if os.path.basename(d) == "scripts":
            return d
        d = os.path.dirname(d)
    return None


def _copy_tree(scripts_root, dest_dir):
    dest_scripts = os.path.join(dest_dir, "scripts")
    os.makedirs(dest_scripts, exist_ok=True)
    # top-level data files (scripts/chokepoints.json, ...): a hook that reads
    # one beside itself fails open on BOTH sides without it (HIMMEL-4219).
    for name in os.listdir(scripts_root):
        s = os.path.join(scripts_root, name)
        if os.path.isfile(s):
            shutil.copy2(s, os.path.join(dest_scripts, name))
    for sub in ("hooks", "guardrails", "lib"):
        s = os.path.join(scripts_root, sub)
        if os.path.isdir(s):
            shutil.copytree(s, os.path.join(dest_scripts, sub),
                            dirs_exist_ok=True)


def _materialise_tree(repo, sha, dest_dir):
    dest_scripts = os.path.join(dest_dir, "scripts")
    os.makedirs(dest_scripts, exist_ok=True)
    # "" = the top-level files of scripts/ (non-recursive, blobs only); the
    # three subtrees are exported recursively (HIMMEL-4219).
    for sub in ("", "hooks", "guardrails", "lib"):
        # keep the tree's mode (not --name-only): a 100755 helper copied as
        # 0644 would fail only on the sha-materialised side when invoked
        # directly, distorting the base/head comparison (vs _copy_tree, which
        # preserves modes via copytree).
        if sub:
            ls_args = ["ls-tree", "-r", sha, "scripts/%s" % sub]
        else:
            ls_args = ["ls-tree", sha, "scripts/"]
        listing = subprocess.run(
            ["git", "-C", repo] + ls_args,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        # A failed listing (bad sha, unreadable repo) must not pass silently as
        # an empty subtree: an incomplete hook dependency tree could let the
        # materialised hook mis-decide (e.g. allow where it should deny) and
        # read as a false clean. Fail loud -> caught as a setup error (exit 2).
        if listing.returncode != 0:
            raise RuntimeError("git ls-tree %s scripts/%s failed: %s" % (
                sha, sub, listing.stderr.decode("utf-8", "replace").strip()))
        for line in listing.stdout.decode("utf-8", "replace").splitlines():
            meta, rel = line.split("\t", 1)
            mode = meta.split()[0]
            if meta.split()[1] != "blob":
                continue  # a subtree entry of the non-recursive top listing
            blob = subprocess.run(["git", "-C", repo, "show", "%s:%s" % (sha, rel)],
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            # a file the listing names but `show` cannot read is a broken tree,
            # not a file to skip -- same fail-loud reasoning as the listing.
            if blob.returncode != 0:
                raise RuntimeError("git show %s:%s failed: %s" % (
                    sha, rel, blob.stderr.decode("utf-8", "replace").strip()))
            dst = os.path.join(dest_dir, rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(dst, "wb") as fh:
                fh.write(blob.stdout)
            if mode == "100755":
                os.chmod(dst, 0o755)


def make_scratch_primary(parent):
    """A throwaway git repo on branch main standing in for the primary."""
    repo = os.path.join(parent, "scratch-primary")
    os.makedirs(repo, exist_ok=True)
    # hermetic env: an inherited GIT_TEMPLATE_DIR would make `git init` copy
    # external hooks into this repo that the seed commit then runs, so the
    # scratch git runs under the allowlist like the hooks do.
    env = _sandbox_env(HOME=parent)

    def _git(args):
        r = subprocess.run(["git", "-C", repo] + args, env=env,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if r.returncode != 0:
            raise RuntimeError("scratch-primary setup failed: git %s: %s" % (
                " ".join(args), r.stderr.decode("utf-8", "replace").strip()))

    # An unchecked git setup would leave the scratch repo not a work tree (or
    # not on main), silently voiding the main-checkout guard's coverage while
    # the differential still reported success. Check every step, and confirm
    # the result before any hook runs against it.
    _git(["init", "-q", "-b", "main"])
    _git(["config", "user.email", "x@example.com"])
    _git(["config", "user.name", "x"])
    with open(os.path.join(repo, "seed.txt"), "w") as fh:
        fh.write("seed\n")
    _git(["add", "-A"])
    _git(["commit", "-q", "-m", "chore: seed"])
    branch = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=repo, env=env)
    if branch != "main":
        raise RuntimeError("scratch-primary is on %r, expected 'main'" % branch)
    return repo


def _fresh_sandbox(template_primary, parent):
    """An isolated (primary, HOME, HANDOVER_DIR) triple for ONE hook run.

    Each hook invocation gets its own copy of the scratch primary plus an
    empty HOME and HANDOVER_DIR, so a hook that writes state cannot contaminate
    another row or the other side of the base/head comparison, and concurrent
    rows cannot race on shared paths. Returns (primary, home, handover,
    sandbox_dir); the caller removes sandbox_dir when the run is done.
    """
    sand = tempfile.mkdtemp(prefix="gc-inv.", dir=parent)
    primary = os.path.join(sand, "primary")
    shutil.copytree(template_primary, primary)
    home = os.path.join(sand, "home")
    handover = os.path.join(sand, "handover")
    os.makedirs(home)
    os.makedirs(handover)
    return primary, home, handover, sand


def _add_worktree(primary, sand):
    """A scratch worktree of the per-row primary on a feature branch."""
    wt = os.path.join(sand, "worktree")
    r = subprocess.run(
        ["git", "-C", primary, "worktree", "add", "-q", "-b",
         "feat/guard-corpus", wt],
        env=_sandbox_env(HOME=sand), stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE)
    if r.returncode != 0:
        raise RuntimeError("scratch worktree setup failed: %s"
                           % r.stderr.decode("utf-8", "replace").strip())
    return wt


def _subst(value, mapping):
    """Replace every placeholder in every string of a JSON value."""
    if isinstance(value, str):
        for k, v in mapping.items():
            value = value.replace(k, v)
        return value
    if isinstance(value, list):
        return [_subst(v, mapping) for v in value]
    if isinstance(value, dict):
        return {k: _subst(v, mapping) for k, v in value.items()}
    return value


def decision(rc, stdout):
    """The hook's verdict: deny | ask | pass | approve, or rc if it errored.

    Exit 2 is a deny. At exit 0 the hook may still decide through JSON on
    stdout: hookSpecificOutput.permissionDecision (deny/ask/allow) or the
    legacy top-level decision (block/approve). A top-level "continue": false
    stops the call, so it ranks as deny. An explicit allow is `approve`;
    exit 0 with no decision (or stdout that is not JSON, which the harness
    shows as plain output) is `pass` (the normal prompt flow).
    """
    if rc == 2:
        return "deny"
    if rc != 0:
        return rc
    text = stdout.decode("utf-8", "replace")
    bom = text.startswith("﻿")
    try:
        out = json.loads(text[1:] if bom else text)
    except ValueError:
        return "pass"
    if not isinstance(out, dict):
        return "pass"
    if bom:
        # HIMMEL-4586: the hooks doc says stdout is read as JSON when it starts
        # with { "ignoring surrounding whitespace" and never mentions a BOM, so
        # whether the harness honours this decision is undocumented. Inconclusive
        # (ODD, exit 3), never `pass`: a deny must not score as an allow.
        return "bom"
    if out.get("continue") is False:
        return "deny"
    hso = out.get("hookSpecificOutput")
    d = hso.get("permissionDecision") if isinstance(hso, dict) else None
    if d in ("deny", "ask"):
        return d
    if d == "allow":
        return "approve"
    legacy = out.get("decision")
    if legacy == "block":
        return "deny"
    if legacy == "approve":
        return "approve"
    return "pass"


# Strictness of a clean decision. A head below its base on this scale
# loosened the verdict: a lost deny, a deny downgraded to ask, an ask that
# no longer asks, or a newly approved row in an approver hook.
RANK = {"approve": 0, "pass": 1, "ask": 2, "deny": 3}


def run_one_hook(hook_path, tool_name, tool_input, cwd, anchor, home,
                 handover, timeout_run, context=None):
    """Pipe a JSON payload to the hook on stdin.

    Returns (rc, stdout, wall_seconds); rc is the hook's exit code, or the
    string 'TIMEOUT'. Nothing from the payload is ever executed; the hook
    launches through the fail-closed sandbox runner.
    """
    body = {
        "tool_name": tool_name,
        "tool_input": tool_input,
        "cwd": cwd,
    }
    body.update(context or {})
    payload = json.dumps(body)
    # hermetic env (allowlist): no BASH_ENV/ENV/LD_PRELOAD to run code before
    # the hook reads stdin, no GIT_* redirect, and the inherited bypass seams
    # (EDIT_ON_MAIN_OK etc.) are absent by construction, so the corpus measures
    # the guard itself.
    tree_root = os.path.dirname(os.path.dirname(os.path.dirname(hook_path)))
    overrides = dict(
        HOME=home,
        HANDOVER_DIR=handover,
        # anchor HIMMEL_REPO at the per-row scratch primary (cwd), never the
        # real checkout: a hook that resolves helpers/state off it stays inside
        # the throwaway, and base and head see the identical sandbox anchor.
        HIMMEL_REPO=anchor,
        CLAUDE_PROJECT_DIR=tree_root,
    )
    # each side reads ITS OWN registry copy (never an inherited path): set only
    # when the materialised tree carries one (HIMMEL-4219).
    registry = os.path.join(tree_root, "scripts", "chokepoints.json")
    if os.path.isfile(registry):
        overrides["CHOKEPOINT_REGISTRY"] = registry
    env = _sandbox_env(**overrides)
    launch_env = env.copy()
    # HIMMEL-4912: classify every row behind the kernel filesystem/network
    # fence. Only immutable hook/cwd inputs cross it; state lives in tmpfs.
    runner = os.path.abspath(os.path.join(os.path.dirname(__file__),
                                         "..", "..", "lib", "sandbox-run.sh"))
    scripts_root = _find_scripts_root(hook_path)
    hook_tree = os.path.dirname(scripts_root) if scripts_root else os.path.dirname(hook_path)
    argv = []
    for path in dict.fromkeys((hook_tree, anchor, cwd)):
        argv.extend(["--read-only", path])
    # HOME/TMPDIR come from the runner, never from host fixture paths.
    env.pop("HOME", None)
    env.pop("TMPDIR", None)
    env.pop("TMP", None)
    env.pop("TEMP", None)
    env.pop("PATH", None)
    env.pop("HANDOVER_DIR", None)
    argv.extend(["--", "/usr/bin/env"] + ["%s=%s" % item for item in env.items()])
    argv.extend(["bash", "-c", 'export HANDOVER_DIR="$TMPDIR/handover"; mkdir -p "$HANDOVER_DIR"; exec bash "$1"', "sandbox-hook", hook_path])
    t0 = time.time()
    # stdout goes to a temp file, not a pipe: a pipe's EOF waits on every
    # process holding the write end, so a hook that backgrounds a child would
    # read as TIMEOUT. The hook's own exit ends the row (HIMMEL-4587); the
    # group is then killed so the child never outlives the row.
    with tempfile.TemporaryFile() as outf:
        p = subprocess.Popen(["bash", runner] + argv, stdin=subprocess.PIPE,
                             stdout=outf, stderr=subprocess.DEVNULL,
                             start_new_session=True, cwd=cwd, env=launch_env)
        try:
            p.communicate(payload.encode("utf-8", "surrogateescape"),
                          timeout=timeout_run)
            rc = p.returncode
        except subprocess.TimeoutExpired:
            rc = "TIMEOUT"
        try:
            os.killpg(p.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        p.wait()
        outf.seek(0)
        out = outf.read()
    return rc, out, time.time() - t0


def _record_run(args, rc, results, metrics):
    """One eval-runs ledger row per diff (HIMMEL-4647). A regression (rc 1) is
    a valid measurement; odd/vacuous/no-control runs are inconclusive, and so
    is a regression run with odd rows (it did not fully exercise the guard). A
    ledger failure warns and never changes the diff's exit code."""
    try:
        _record_run_row(args, rc, results, metrics)
    except Exception as e:  # the row is a by-product; the diff's verdict stands
        print("guard-corpus diff: WARNING eval-runs row not written: %s" % e, file=sys.stderr)


def _record_run_row(args, rc, results, metrics):
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "lib"))
    import eval_runs
    gitsha = None
    if args.head.startswith("sha:"):
        out = subprocess.run(["git", "-C", args.repo, "rev-parse", "--verify", "-q",
                              args.head[4:].split(":", 1)[0] + "^{commit}"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        gitsha = out.stdout.decode().strip() or None
    top = subprocess.run(["git", "-C", args.repo, "rev-parse", "--show-toplevel"],
                         stdout=subprocess.PIPE, stderr=subprocess.DEVNULL).stdout.decode().strip()
    root = top or os.path.abspath(args.repo)
    def hook_name(spec):
        # HIMMEL-4659: repo-relative, so a checkout root does not change the identity
        # and two hooks sharing a file name do not collide. sha: specs already are.
        # A hook outside the repo has no repo-relative path: its basename stays.
        if spec.startswith("sha:"):
            return spec.rsplit(":", 1)[-1]
        rel = os.path.relpath(os.path.realpath(spec), os.path.realpath(root))
        return os.path.basename(spec) if rel.startswith("..") else rel
    try:
        corpus_sha = eval_runs.file_sha256(args.corpus)
    except OSError:
        corpus_sha = None
    config = dict(hook=hook_name(args.head), base_hook=hook_name(args.base), corpus_sha256=corpus_sha,
                  timeout_warn=args.timeout_warn)
    cases = {str(r["idx"]): dict(base=r["base"] == "deny", head=r["head"] == "deny")
             for r in results}
    row = eval_runs.make_row(
        "guard-corpus", "scripts/eval/guard-corpus/diff", config, metrics,
        n=len(results), status="ok" if rc in (0, 1) and not metrics["odd_rc"] else "inconclusive",
        cases=cases, artifact=os.path.abspath(args.corpus),
        meta=dict(base=args.base, head=args.head, exit=rc),
        repo=args.repo, gitsha=gitsha)
    eval_runs.append_safe(row, who="guard-corpus diff")


def main(argv):
    ap = argparse.ArgumentParser(
        prog="diff", add_help=True,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="exit codes: 0 clean; 1 base-deny/head-allow regression; "
               "2 setup error or empty corpus; 3 inconclusive (odd rc, "
               "timeout kill, or deny seeds the base never denied); "
               "4 VACUOUS (deny-expected rows, neither side denied any: the "
               "hook fails open, e.g. a missing data dependency).")
    ap.add_argument("--base", required=True, help="hook path or sha:REL/PATH")
    ap.add_argument("--head", required=True, help="hook path or sha:REL/PATH")
    ap.add_argument("--corpus", required=True, help="JSONL from gen")
    ap.add_argument("--repo", default=".", help="repo for sha: specs")
    ap.add_argument("--timeout-run", type=float, default=15.0,
                    help="per-row hard timeout (kills the hook)")
    ap.add_argument("--timeout-warn", type=float, default=5.0,
                    help="wall time over this => TIMEOUT RISK")
    ap.add_argument("--jobs", type=int, default=8)
    ap.add_argument("--no-json", action="store_true")
    args = ap.parse_args(argv)

    # Launched subprocesses (the hook under test, the scratch git) get the
    # strict allowlist env from _sandbox_env. This scrub covers the remaining
    # AMBIENT git reads against the judge's --repo (materialise's ls-tree/show),
    # which run under os.environ: inherited GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE
    # (and friends) take precedence over `git -C`, so a stray one would redirect
    # those reads into a REAL repository. Strip the location + config families
    # here so no ambient git call can be steered off the judge's repo either.
    for _k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_COMMON_DIR",
               "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES"):
        os.environ.pop(_k, None)

    # Inherited Git CONFIG overrides are a second, nastier redirect: a
    # GIT_CONFIG_GLOBAL/GIT_CONFIG_SYSTEM file, or a GIT_CONFIG_COUNT +
    # GIT_CONFIG_KEY_n/GIT_CONFIG_VALUE_n set, can carry core.hooksPath, which
    # would make our scratch `git commit` (and a hook's own git calls) EXECUTE
    # real hooks living outside the sandbox. Stripping the location family above
    # does not touch these. Drop the whole GIT_CONFIG* family, then pin global
    # and system config to an empty file so no external config -- hooksPath
    # included -- is honored by any git we or the hook run.
    for _k in list(os.environ):
        if _k == "GIT_CONFIG" or _k.startswith("GIT_CONFIG_"):
            os.environ.pop(_k, None)
    os.environ["GIT_CONFIG_GLOBAL"] = os.devnull
    os.environ["GIT_CONFIG_SYSTEM"] = os.devnull

    # A corrupt/truncated JSON line (json.JSONDecodeError) or an unreadable
    # corpus (OSError) is a SETUP error, not a regression. Left uncaught, the
    # exception makes Python exit 1 -- the documented regression code -- so a
    # judge would read a broken corpus as a confirmed regression. Catch it and
    # return 2.
    try:
        with open(args.corpus, "r", encoding="utf-8") as fh:
            raw_rows = [(n, json.loads(line))
                        for n, line in enumerate(fh, 1) if line.strip()]
    except (OSError, json.JSONDecodeError) as exc:
        print("guard-corpus diff: cannot read corpus %s: %s" % (args.corpus, exc),
              file=sys.stderr)
        return 2

    # Validate the row shape at load time, for the same reason: a malformed row
    # would raise KeyError/TypeError inside the worker and again exit 1. A
    # malformed row is a setup error -> exit 2. tool_name defaults to Bash; a
    # Bash row needs a string tool_input.command, any other tool an object
    # tool_input (HIMMEL-4537). cwd, if given, is one of ROW_CWDS, and the
    # context keys, if given, are strings.
    corpus = []
    for lineno, row in raw_rows:
        problem = None
        if not isinstance(row, dict):
            problem = "row is not an object"
        else:
            tool = row.get("tool_name", "Bash")
            tin = row.get("tool_input")
            if not isinstance(tool, str):
                problem = "tool_name is not a string"
            elif not isinstance(tin, dict):
                problem = "tool_input is not an object"
            elif tool == "Bash" and not isinstance(tin.get("command"), str):
                problem = "missing string tool_input.command"
            elif row.get("cwd", "primary") not in ROW_CWDS:
                problem = "cwd must be one of %s" % ", ".join(ROW_CWDS)
            elif any(k in row and not isinstance(row[k], str)
                     for k in CONTEXT_KEYS):
                problem = "%s must be strings" % ", ".join(CONTEXT_KEYS)
        if problem:
            print("guard-corpus diff: corpus %s line %d: %s"
                  % (args.corpus, lineno, problem), file=sys.stderr)
            return 2
        corpus.append(row)

    # An empty corpus exercises no hook, so a clean exit 0 here would be a
    # false "reviewed clean" for a judge who generated nothing or pointed at
    # the wrong file. Refuse it (fail-closed) rather than certify zero rows.
    if not corpus:
        print("guard-corpus diff: corpus %s has no rows" % args.corpus,
              file=sys.stderr)
        return 2

    workdir = tempfile.mkdtemp(prefix="guard-corpus-diff.")
    try:
        base_dir = os.path.join(workdir, "base")
        head_dir = os.path.join(workdir, "head")
        try:
            os.makedirs(base_dir)
            os.makedirs(head_dir)
            base_hook = materialise_hook(args.base, args.repo, base_dir)
            head_hook = materialise_hook(args.head, args.repo, head_dir)
            # built ONCE as a template; each invocation copies it (see
            # _fresh_sandbox) so no two runs share a primary.
            template = make_scratch_primary(workdir)
        except (RuntimeError, OSError) as e:
            # OSError too: a failed mkdir/copy (missing filesystem hook, full
            # disk) is a setup failure, not a confirmed base-deny/head-allow
            # regression -- exit 2, never the regression code 1.
            print("guard-corpus diff: setup error: %s" % e, file=sys.stderr)
            return 2

        def _run_side(hook, row):
            prim, home, handover, sand = _fresh_sandbox(template, workdir)
            try:
                mapping = {PLACEHOLDER: prim}
                cwd = prim
                if row.get("cwd") == "worktree":
                    cwd = _add_worktree(prim, sand)
                    mapping[WT_PLACEHOLDER] = cwd
                tin = _subst(row["tool_input"], mapping)
                ctx = {k: row[k] for k in CONTEXT_KEYS if k in row}
                rc, out, wall = run_one_hook(
                    hook, row.get("tool_name", "Bash"), tin, cwd, prim, home,
                    handover, args.timeout_run, ctx)
                return rc, decision(rc, out), wall
            finally:
                shutil.rmtree(sand, ignore_errors=True)

        def one(idx_row):
            idx, row = idx_row
            rb, db, tb = _run_side(base_hook, row)
            rh, dh, th = _run_side(head_hook, row)
            return dict(idx=idx, family=row.get("family"),
                        transform=row.get("transform"), expect=row.get("expect"),
                        rb=rb, rh=rh, base=db, head=dh, tb=tb, th=th)

        # Every sandbox launch scans the runtime tree (sandbox-run.sh runtime
        # masks). On a cold CI disk the first parallel batch spent its whole
        # --timeout-run in that scan (rows 0-3 TIMEOUT on both sides, later rows
        # fine), so read the tree once, serially and unbounded, before the pool.
        # ponytail: warms the page cache, does not remove the per-launch scan;
        # the upgrade path is one mask list per run (HIMMEL-5055).
        for root in ("/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc"):
            for dirpath, dirnames, filenames in os.walk(root):
                for name in dirnames + filenames:
                    try:
                        os.lstat(os.path.join(dirpath, name))
                    except OSError:
                        pass
        with ThreadPoolExecutor(args.jobs) as ex:
            results = list(ex.map(one, enumerate(corpus)))

        # A regression is a CLEAN base-deny paired with a CLEAN head-allow.
        # Require head == 0 (a genuine allow), not merely "head != 2": a head
        # that errored (rc 1) or was killed ("TIMEOUT") did NOT allow the
        # command, it failed to run, so it is inconclusive (caught by `odd`
        # below, exit 3), never a confirmed regression. Same for `newly`:
        # require a CLEAN base-allow, so a base error/timeout is not misread
        # as a clean allow that the head then denied.
        # HIMMEL-4537: both sides are now DECISIONS (deny/ask/pass/approve),
        # read from the exit code and the JSON on stdout, so a regression is
        # any clean head looser than its clean base on RANK: a lost deny
        # (exit-2 or JSON), a deny downgraded to ask, an ask that no longer
        # asks, or a row an approver hook newly approves.
        clean = [r for r in results if r["base"] in RANK and r["head"] in RANK]
        regressions = [r for r in clean if RANK[r["head"]] < RANK[r["base"]]]
        newly = [r for r in clean if r["head"] == "deny" and r["base"] != "deny"]
        odd = [r for r in results
               if r["base"] not in RANK or r["head"] not in RANK]
        slow = [r for r in results
               if max(r["tb"], r["th"]) >= args.timeout_warn]
        # deny-side positive control: of the rows the judge marked expect=deny,
        # how many did the BASE actually deny? If a judge supplied deny seeds
        # but none fired, the corpus proved no deny coverage and a clean 0
        # would be a false "reviewed clean" -- make it inconclusive (exit 3).
        deny_expected = [r for r in results if r.get("expect") == "deny"]
        deny_fired = [r for r in deny_expected if r["base"] == "deny"]
        deny_allowed_both = [r for r in deny_expected
                             if r["base"] in ("pass", "approve")
                             and r["head"] in ("pass", "approve")]
        no_deny_control = bool(deny_expected) and not deny_fired
        # VACUOUS: deny seeds exist and NEITHER side denied any -- a hook that
        # fails open (missing data dependency, broken registry) on both sides
        # reads as 0 regressions but proved nothing (HIMMEL-4219).
        head_fired = [r for r in deny_expected if r["head"] == "deny"]
        vacuous = bool(deny_expected) and not deny_fired and not head_fired
        # over-deny (HIMMEL-4537): allow-expected rows (the benign twins) a
        # side denied. Reported, never an exit code: over-deny is friction,
        # not an escape.
        allow_expected = [r for r in results if r.get("expect") == "allow"]
        over_base = [r for r in allow_expected if r["base"] == "deny"]
        over_head = [r for r in allow_expected if r["head"] == "deny"]

        print("guard-corpus diff: %d rows" % len(results))
        print("  base-deny/head-allow (REGRESSION): %d" % len(regressions))
        for r in regressions:
            print("    REGRESSION idx=%d family=%s transform=%s base=%s head=%s"
                  % (r["idx"], r["family"], r["transform"], r["base"], r["head"]))
        print("  newly-denied: %d" % len(newly))
        for r in newly[:50]:
            print("    NEWLY-DENIED idx=%d family=%s transform=%s"
                  % (r["idx"], r["family"], r["transform"]))
        print("  rc not in {0,2}: %d" % len(odd))
        for r in odd[:50]:
            print("    ODD-RC idx=%d base=%s head=%s rb=%s rh=%s tb=%.1fs th=%.1fs"
                  % (r["idx"], r["base"], r["head"], r["rb"], r["rh"], r["tb"], r["th"]))
        print("  TIMEOUT RISK (>= %.1fs): %d" % (args.timeout_warn, len(slow)))
        for r in slow[:50]:
            print("    TIMEOUT-RISK idx=%d tb=%.2f th=%.2f transform=%s"
                  % (r["idx"], r["tb"], r["th"], r["transform"]))
        print("  deny-expected rows: %d (base denied %d; allowed by both: %d)"
              % (len(deny_expected), len(deny_fired), len(deny_allowed_both)))
        if no_deny_control:
            print("    WARNING: no deny-expected row was denied by base -- "
                  "this corpus demonstrated NO deny-side coverage")
        for r in deny_allowed_both[:50]:
            print("    DENY-MISSED idx=%d family=%s transform=%s "
                  "(both hooks allowed a deny-expected row)"
                  % (r["idx"], r["family"], r["transform"]))
        print("  allow-expected rows: %d (denied by base %d; by head %d)"
              % (len(allow_expected), len(over_base), len(over_head)))
        for r in [r for r in allow_expected
                  if r in over_base or r in over_head][:50]:
            print("    OVER-DENY idx=%d family=%s transform=%s base=%s head=%s"
                  % (r["idx"], r["family"], r["transform"], r["base"], r["head"]))
        if vacuous:
            print("VACUOUS: %d deny-expected row(s) and NEITHER base nor head "
                  "denied any; the hook likely fails open (missing data "
                  "dependency?) on both sides, so 0 regressions proves nothing"
                  % len(deny_expected))

        if not args.no_json:
            print("JSON " + json.dumps(dict(
                rows=len(results), regressions=len(regressions),
                newly_denied=len(newly), odd_rc=len(odd), timeout_risk=len(slow),
                deny_expected=len(deny_expected), deny_base_fired=len(deny_fired),
                deny_allowed_both=len(deny_allowed_both),
                allow_expected=len(allow_expected),
                over_deny_base=len(over_base), over_deny_head=len(over_head))))

        if regressions:
            rc = 1
        # odd includes rc=="TIMEOUT" (hard kill) and any error rc: such a run
        # never validly exercised the guard, so it is inconclusive, not clean.
        elif odd:
            rc = 3
        # distinct from 3: both sides ran cleanly yet neither denied a seed.
        elif vacuous:
            rc = 4
        # deny seeds supplied but the base denied none: the positive control
        # never fired, so the "no regression" result proves nothing.
        elif no_deny_control:
            rc = 3
        else:
            rc = 0
        _record_run(args, rc, results, dict(
            regressions=len(regressions), newly_denied=len(newly),
            odd_rc=len(odd), timeout_risk=len(slow),
            deny_expected=len(deny_expected), deny_base_fired=len(deny_fired),
            deny_allowed_both=len(deny_allowed_both),
            deny_coverage=(len(deny_fired) / len(deny_expected)
                           if deny_expected else None),
            allow_expected=len(allow_expected),
            over_deny_base=len(over_base), over_deny_head=len(over_head)))
        return rc
    except (RuntimeError, OSError) as e:
        # A per-row sandbox copy (disk exhaustion) or hook launch (missing bash)
        # raises inside the worker pool and ex.map re-raises it here. That is a
        # setup failure of the harness, not a confirmed base-deny/head-allow
        # regression -- return the setup-error code 2, never the uncaught exit 1
        # that would falsely certify a regression.
        print("guard-corpus diff: run error: %s" % e, file=sys.stderr)
        return 2
    finally:
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
