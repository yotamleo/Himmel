{
  "_comment": "Ledger registry (HIMMEL-4290). One row per append-only ledger himmel writes. Linted by scripts/observability/test-ledgers-registry.sh: writer/readers must exist and reference the ledger, every ~/.himmel ledger a script spells out must have a row, and a non-grandfathered row must carry min_envelope. 'envelope' lists which min_envelope fields the rows carry today; rows predating the registry are grandfathered.",
  "v": 1,
  "min_envelope": ["v", "ts", "host", "source", "kind"],
  "ledgers": [
    {
      "id": "flow-runs",
      "default_path": "~/.himmel/flow-runs.jsonl",
      "override_env": "HIMMEL_FLOW_RUNS_LEDGER",
      "writer": "scripts/telegram/flow-run-ledger.ts",
      "readers": ["scripts/observability/flow-exporter.ts", "scripts/observability/ledger-prune.sh"],
      "format": "jsonl",
      "rotation": "none; unpaired start rows pruned on demand by ledger-prune.sh",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["v", "host"],
      "grandfathered": true
    },
    {
      "id": "quota-gauge",
      "default_path": "~/.himmel/quota-gauge.jsonl",
      "override_env": "HIMMEL_QUOTA_GAUGE_LEDGER",
      "writer": "scripts/telegram/quota-gauge.ts",
      "readers": ["scripts/observability/flow-exporter.ts", "scripts/lib/quota-gauge-ledger-path.sh"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["v", "ts", "source"],
      "grandfathered": true
    },
    {
      "id": "ci-queue",
      "default_path": "~/.himmel/ci-queue.jsonl",
      "override_env": "HIMMEL_CI_QUEUE_LEDGER",
      "writer": "scripts/ci-orchestrator/src/ledger.ts",
      "readers": ["scripts/lib/ci-queue-ledger-path.sh"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["ts"],
      "grandfathered": true
    },
    {
      "id": "session-runs",
      "default_path": "~/.himmel/session-runs.jsonl",
      "override_env": "HIMMEL_SESSION_RUNS_LEDGER",
      "writer": "scripts/observability/session-run-ledger.ts",
      "readers": ["scripts/observability/flow-exporter.ts"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["v", "host", "kind"],
      "grandfathered": true
    },
    {
      "id": "tool-call-census",
      "default_path": "~/.himmel/tool-call-census.jsonl",
      "override_env": "HIMMEL_TOOL_CENSUS",
      "writer": "scripts/observability/tool-call-census.sh",
      "readers": ["scripts/observability/flow-exporter.ts"],
      "format": "jsonl",
      "rotation": "rewritten per run, keyed by session_id",
      "retention": "HIMMEL_TOOL_CENSUS_RETAIN_DAYS (default 14d)",
      "schema_version": 1,
      "envelope": [],
      "grandfathered": true
    },
    {
      "id": "hermes-egress",
      "default_path": "~/.himmel/hermes-egress.jsonl",
      "override_env": "HIMMEL_HERMES_EGRESS_LEDGER",
      "writer": "scripts/hermes/egress-gate.sh",
      "readers": [],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded (audit trail)",
      "schema_version": 1,
      "envelope": ["ts"],
      "grandfathered": true
    },
    {
      "id": "classifier-denials",
      "default_path": "~/.himmel/state/classifier-denials.jsonl",
      "override_env": "HIMMEL_CLASSIFIER_DENIALS_LOG",
      "writer": "scripts/hooks/log-classifier-denial.sh",
      "readers": ["scripts/handover/console-kit/tick.sh"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["ts"],
      "grandfathered": true
    },
    {
      "id": "cadence-bank",
      "default_path": "~/.himmel/cadence-ledger.jsonl",
      "override_env": "CADENCE_BANK_LEDGER",
      "writer": "scripts/lib/bank-preflight.sh",
      "readers": [],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["ts"],
      "grandfathered": true
    },
    {
      "id": "cadence-alerts",
      "default_path": "~/.himmel/state/cadence-alerts.log",
      "override_env": "CADENCE_ALERT_FILE",
      "writer": "scripts/luna/cadence-alert.sh",
      "readers": [],
      "format": "text",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 0,
      "envelope": [],
      "grandfathered": true
    },
    {
      "id": "hook-chain-skips",
      "default_path": "<repo>/.claude/logs/hook-chain-skips.jsonl",
      "override_env": "RUN_HOOK_CHAIN_SKIP_LOG",
      "writer": "scripts/hooks/run-hook-with-bash.js",
      "readers": ["scripts/observability/flow-exporter.ts", "scripts/himmel-doctor.sh"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["ts"],
      "grandfathered": true
    },
    {
      "id": "firecrawl-ledger",
      "default_path": "~/.himmel/state/firecrawl-ledger.jsonl",
      "override_env": "HIMMEL_FIRECRAWL_LEDGER",
      "writer": "marketplace/plugins/obsidian-triage/tools/harvest-clip-body-batch.py",
      "readers": ["marketplace/plugins/obsidian-triage/tools/lib/follow-web.mjs", "scripts/luna/fetch-health.py"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["v", "ts", "host", "source", "kind"],
      "grandfathered": false
    },
    {
      "id": "firecrawl-parked",
      "default_path": "~/.himmel/state/firecrawl-parked.jsonl",
      "override_env": "HIMMEL_FIRECRAWL_PARKED",
      "writer": "marketplace/plugins/obsidian-triage/tools/harvest-clip-body-batch.py",
      "readers": ["marketplace/plugins/obsidian-triage/tools/lib/follow-web.mjs", "scripts/himmel-doctor.sh"],
      "format": "jsonl",
      "rotation": "none",
      "retention": "unbounded",
      "schema_version": 1,
      "envelope": ["v", "ts", "host", "source", "kind"],
      "grandfathered": false
    }
  ]
}
