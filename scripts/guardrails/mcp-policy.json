        "browser_network_requests": "read", "browser_network_request": "read", "browser_tabs": "read",
        "browser_find": "read", "browser_wait_for": "read",
        "browser_navigate": "write", "browser_navigate_back": "write", "browser_click": "write",
        "browser_type": "write", "browser_press_key": "write", "browser_hover": "write",
        "browser_drag": "write", "browser_drop": "write", "browser_select_option": "write",
        "browser_fill_form": "write", "browser_handle_dialog": "write", "browser_resize": "write",
