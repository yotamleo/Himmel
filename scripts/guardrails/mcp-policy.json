    "context7": {
      "verdict": "allow", "egress": "off-box", "provider": null, "note": "Upstash Context7; the query text leaves the box",
      "tools": { "resolve-library-id": "read", "query-docs": "read" }
    },
    "plugin_context7_context7": {
      "verdict": "allow", "egress": "off-box", "provider": null, "note": "context7@claude-plugins-official",
      "tools": { "resolve-library-id": "read", "query-docs": "read" }
    },
    "claude_ai_Context7": {
      "verdict": "allow", "egress": "off-box", "provider": null, "note": "claude.ai connector",
