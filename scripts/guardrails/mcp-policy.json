        "unmark_message_spam": "write", "unmark_thread_spam": "write", "untrash_message": "write",
        "untrash_thread": "write",
        "send_message": "destructive", "reply": "destructive", "forward": "destructive",
        "trash_message": "destructive", "trash_thread": "destructive", "delete_draft": "destructive",
        "delete_label": "destructive"
      },
      "allow_destructive": []
    },
    "claude_ai_Google_Calendar": {
      "verdict": "allow", "egress": "off-box", "provider": null, "note": "claude.ai Google Calendar connector",
      "tools": {
