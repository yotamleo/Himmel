{
  "version": 1,
  "jira": "HIMMEL-4676",
  "doc": "docs/internals/enforcement.md#mcp-policy-tracking-himmel-4676",
  "semantics": {
    "mode": "observe = the hook ALWAYS allows and only records what it WOULD do. enforce = the would-verdict is applied (deny exits 2). The top-level mode covers unknown servers and malformed calls; a server's own `mode` overrides it for that server. Nothing ships in enforce (operator ruling 2026-10-06, HIMMEL-4676).",
    "server_key": "the <server> in mcp__<server>__<tool>: everything after `mcp__` up to the next `__`. Plugin servers are plugin_<plugin>_<server>, claude.ai connectors are claude_ai_<Name>.",
    "server_verdict": "allow | deny. A deny server would-deny every call.",
    "tool_class": "read (no state change) | write (creates or changes state) | destructive (deletes, trashes, sends, shares, runs arbitrary code, or is a generic write-anything entry point). A destructive tool would-deny unless it is named in the server's allow_destructive.",
    "unlisted": "a server missing from `servers`, or a tool missing from its server's `tools`, would-deny. The audit line names the entry to add.",
    "egress": "local = the server runs on this machine and sends nothing off-box itself. off-box = tool arguments leave the machine; `provider` names an egress-matrix.json provider when one exists (null when the matrix has none). An off-box server whose provider carries a corpus:* purpose:* deny row in egress-matrix.json would-deny. The matrix stays authoritative and is only read here.",
    "audit": "one JSONL line per call to $HOME/.himmel/state/mcp-audit.jsonl (ts, session, server, tool, class, egress, mode, verdict, reason). Never any tool argument. Rotated to .1 past max_bytes."
  },
  "mode": "observe",
  "audit": { "max_bytes": 1048576 },
  "servers": {
    "qmd": {
      "verdict": "allow", "egress": "local", "note": "qmd HTTP daemon on localhost:8181 (user-scope registration)",
      "tools": { "query": "read", "get": "read", "multi_get": "read", "status": "read" }
    },
    "plugin_qmd_qmd": {
      "verdict": "allow", "egress": "local", "note": "qmd@himmel plugin, same daemon",
      "tools": { "query": "read", "get": "read", "multi_get": "read", "status": "read" }
    },
    "graphify": {
      "verdict": "allow", "egress": "local", "note": "graphify-mcp over the local graph.json",
      "tools": {
        "query_graph": "read", "get_node": "read", "get_neighbors": "read", "get_community": "read",
        "god_nodes": "read", "graph_stats": "read", "shortest_path": "read", "list_prs": "read",
        "get_pr_impact": "read", "triage_prs": "read"
      }
    },
    "obsidian-vault": {
      "verdict": "allow", "egress": "local", "note": "mcp-obsidian against the local Obsidian REST API; reads luna-personal",
      "tools": {
        "obsidian_simple_search": "read", "obsidian_complex_search": "read", "obsidian_search_by_tag": "read",
        "obsidian_list_files_in_vault": "read", "obsidian_list_files_in_dir": "read",
        "obsidian_get_file_contents": "read", "obsidian_batch_get_file_contents": "read",
        "obsidian_get_frontmatter": "read", "obsidian_get_periodic_note": "read",
        "obsidian_get_recent_periodic_notes": "read", "obsidian_get_recent_changes": "read",
        "obsidian_append_content": "write", "obsidian_patch_content": "write", "obsidian_put_content": "write",
        "obsidian_delete_file": "destructive"
      },
      "allow_destructive": []
    },
    "plugin_obsidian-second-brain_vault": {
      "verdict": "allow", "egress": "local", "note": "obsidian-second-brain@himmel vault MCP",
      "tools": {
        "obsidian_search": "read", "obsidian_read_note": "read", "obsidian_backlinks": "read",
        "obsidian_list_skills": "read", "obsidian_get_skill": "read", "obsidian_vault_health": "read",
        "obsidian_validate_note": "read",
        "obsidian_capture": "write", "obsidian_save_note": "write", "obsidian_update_note": "write",
        "obsidian_replace_text": "write", "obsidian_move_note": "write"
      }
